-- Slider
local refreshers = {}
local function mkSlider(name, key, min, max, y)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 16)
    label.Position = UDim2.new(0, 10, 0, y)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = panel

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -30, 0, 14)
    bar.Position = UDim2.new(0, 10, 0, y + 20)
    bar.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    bar.Parent = panel

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar

    local function show()
        local alpha = math.clamp((cfg[key] - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        label.Text = string.format("%s: %.2f", name, cfg[key])
    end
    local function fromInput(input)
        local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        cfg[key] = min + (max - min) * alpha
        apply()
        show()
    end

    local dragging = false
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            panel.ScrollingEnabled = false
            fromInput(input)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            fromInput(input)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            panel.ScrollingEnabled = true
        end
    end)

    show()
    table.insert(refreshers, show)
end

mkSlider("Far (blur jauh)", "far", 0, 1, 60)
mkSlider("Near (blur dekat)", "near", 0, 1, 104)
mkSlider("Focus Distance", "focus", 0, 300, 148)
mkSlider("In Focus Radius", "radius", 0, 100, 192)

local function refreshAll()
    for _, f in ipairs(refreshers) do f() end
end

-- Tombol
local function mkBtn(text, x, y, w)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, w, 0, 32)
    b.Position = UDim2.new(0, x, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextSize = 12
    b.Text = text
    b.Parent = panel
    return b
end

local testBtn = mkBtn("Tes Blur MAX", 10, 244, 108)
testBtn.MouseButton1Click:Connect(function()
    cfg.far, cfg.near, cfg.focus, cfg.radius = 1, 1, 0, 0
    apply()
    refreshAll()
end)

local resetBtn = mkBtn("Reset", 126, 244, 104)
resetBtn.MouseButton1Click:Connect(function()
    cfg.far, cfg.near, cfg.focus, cfg.radius = DEFAULTS.far, DEFAULTS.near, DEFAULTS.focus, DEFAULTS.radius
    apply()
    refreshAll()
end)

local parentBtn = mkBtn("Parent: " .. parentMode, 10, 282, 108)
parentBtn.MouseButton1Click:Connect(function()
    parentMode = (parentMode == "Lighting") and "Camera" or "Lighting"
    dof.Parent = target()
    apply()
    parentBtn.Text = "Parent: " .. parentMode
end)

local lockBtn = mkBtn("Kunci: OFF", 126, 282, 104)
lockBtn.MouseButton1Click:Connect(function()
    lock = not lock
    lockBtn.Text = "Kunci: " .. (lock and "ON" or "OFF")
    lockBtn.BackgroundColor3 = lock and Color3.fromRGB(0, 120, 60) or Color3.fromRGB(50, 50, 50)
end)

local killBtn = mkBtn("Matikan DOF lain", 10, 320, 220)
killBtn.MouseButton1Click:Connect(function()
    killOthers()
    apply()
end)
