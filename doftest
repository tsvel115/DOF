-- DOF Test Panel (client-side, untuk executor)
local Lighting = game:GetService("Lighting")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local Players = game:GetService("Players")

-- ===== DOF =====
local function findOurs()
    for _, p in ipairs({Lighting, workspace.CurrentCamera}) do
        local e = p:FindFirstChild("TestDOF")
        if e then return e end
    end
end

local dof = findOurs() or Instance.new("DepthOfFieldEffect")
dof.Name = "TestDOF"
dof.Parent = dof.Parent or Lighting

local DEFAULTS = {far = 0.8, near = 0, focus = 20, radius = 10}
local cfg = {far = DEFAULTS.far, near = DEFAULTS.near, focus = DEFAULTS.focus, radius = DEFAULTS.radius}
local parentMode = (dof.Parent == Lighting) and "Lighting" or "Camera"
local lock = false

local function target()
    return parentMode == "Camera" and workspace.CurrentCamera or Lighting
end

local function apply()
    dof.Enabled = true
    dof.FarIntensity = cfg.far
    dof.NearIntensity = cfg.near
    dof.FocusDistance = cfg.focus
    dof.InFocusRadius = cfg.radius
end
apply()

local function otherDOFs()
    local list = {}
    for _, p in ipairs({Lighting, workspace.CurrentCamera}) do
        for _, e in ipairs(p:GetChildren()) do
            if e:IsA("DepthOfFieldEffect") and e ~= dof then
                table.insert(list, e)
            end
        end
    end
    return list
end

local function countActiveOthers()
    local n = 0
    for _, e in ipairs(otherDOFs()) do
        if e.Enabled then n = n + 1 end
    end
    return n
end

local function killOthers()
    for _, e in ipairs(otherDOFs()) do
        e.Enabled = false
    end
end

local function quality()
    local ok, q = pcall(function() return settings().Rendering.QualityLevel end)
    if not ok then return "?" end
    return (tostring(q):gsub("Enum.QualityLevel.", ""))
end

-- Mode kunci: terapkan ulang nilai tiap frame kalau game menimpa
RS.Heartbeat:Connect(function()
    if not lock then return end
    if dof.Parent ~= target() then dof.Parent = target() end
    apply()
    killOthers()
end)

